{
    "scripts": {
        "build": "prisma generate && tsc",
        "build:watch": "tsc --watch",
        "start": "npm run build && npm run db:migrate && node dist/server/server.js",
        "start:codespaces": "node scripts/start-codespaces.mjs",
        "start:watch": "npm run db:migrate && node --watch dist/server/server.js",
        "db:migrate": "node scripts/migrate.mjs",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && node --test"
    },
    "type": "module",
    "engines": {
        "node": ">=22.5.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "dotenv": "^16.6.1",
        "express": "^5.3.0",
        "jsonwebtoken": "^9.0.3",
        "prisma": "^6.19.3"
    }
}
